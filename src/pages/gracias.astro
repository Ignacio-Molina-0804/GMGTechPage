---
import Layout from "../layouts/Layout.astro";
import WhatsappIcon from "../components/icons/WhatsappIcon.astro";

const pageTitle = "Gracias por contactarnos | GMG Tech";
const pageDescription =
  "Tu mensaje fue enviado correctamente. En breve nos pondremos en contacto contigo. GMG Tech — sitios web rápidos, optimizados y con las mejores prácticas.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section
    class="min-h-screen flex flex-col justify-center items-center text-center text-white px-4 sm:px-6 relative overflow-hidden"
  >
    <!-- Fondo decorativo -->
    <div
      class="absolute inset-0 bg-gradient-to-tr from-blue-700/10 via-transparent to-purple-600/10 pointer-events-none"
    >
    </div>

    <!-- Contenido -->
    <div
      class="relative z-10 max-w-2xl mx-auto animate-fade-up opacity-0"
      style="animation: fadeUp 0.8s ease forwards;"
    >
      <!-- Nuevo ícono de confirmación -->
      <div class="flex items-center justify-center mb-8">
        <div
          class="relative w-20 h-20 flex items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-green-500 shadow-[0_0_25px_rgba(0,255,150,0.35)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="white"
            class="w-10 h-10 animate-scale-in"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </div>

      <!-- Título -->
      <h1 class="text-3xl sm:text-4xl font-bold text-blue-400 mb-4">
        ¡Gracias por contactarnos!
      </h1>

      <!-- Descripción -->
      <p
        class="text-gray-300 max-w-2xl mx-auto text-base sm:text-lg mb-8 leading-relaxed"
      >
        Recibimos tu mensaje correctamente y nuestro equipo de
        <span class="text-blue-400 font-semibold">GMG Tech</span> se pondrá en contacto
        con vos lo antes posible. Mientras tanto, podés seguir explorando nuestros
        servicios o escribirnos por WhatsApp.
      </p>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 mt-2">
        <a
          href="/"
          class="px-6 py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium shadow-lg transition-all duration-300"
        >
          Volver al inicio
        </a>
        <a
          href="https://wa.me/5492616406896?text=Hola%20GMG%20Tech!%20Acabo%20de%20enviar%20el%20formulario%20desde%20su%20web%20y%20quiero%20consultar%20por%20sus%20servicios."
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-green-600 hover:bg-green-500 rounded-lg font-semibold shadow-lg shadow-green-700/30 transition-all duration-300 flex items-center justify-center gap-2"
        >
          <span class="flex items-center gap-2">
            <WhatsappIcon />
            Enviar mensaje por WhatsApp
          </span>
        </a>
      </div>
    </div>

    <!-- Animaciones -->
    <style>
      @keyframes fadeUp {
        from {
          transform: translateY(20px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @keyframes scaleIn {
        from {
          transform: scale(0.6);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }

      .animate-scale-in {
        animation: scaleIn 0.4s ease-out forwards;
      }
    </style>
  </section>
</Layout>
