---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Plan Premium | GMG Tech";
const pageDescription = "El Plan Premium de GMG Tech incluye sitio multi-idioma, hosting prioritario y soporte preferencial. Ideal para empresas que buscan expansión internacional y máxima calidad.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="py-12 sm:py-20 text-center text-white max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl font-bold text-blue-400 mb-6">Plan Premium</h2>
    <p class="text-gray-300 max-w-3xl mx-auto text-base sm:text-lg mb-10 sm:mb-12">
      El <strong>Plan Premium</strong> es la opción más completa, creada para empresas que quieren escalar 
      sin límites. Incluye todas las ventajas del Plan Profesional, más funciones avanzadas para llevar tu 
      negocio a un <span class="text-blue-400">nivel internacional</span>.
    </p>

    <!-- Features -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="flex items-start gap-4 bg-gray-800/60 p-5 rounded-xl shadow-md hover:scale-105 transition-transform">
        <span class="text-blue-500 text-2xl">🌍</span>
        <p class="text-gray-200">Sitio multi-idioma para llegar a más clientes</p>
      </div>
      <div class="flex items-start gap-4 bg-gray-800/60 p-5 rounded-xl shadow-md hover:scale-105 transition-transform">
        <span class="text-blue-500 text-2xl">📑</span>
        <p class="text-gray-200">Páginas y vistas ilimitadas</p>
      </div>
      <div class="flex items-start gap-4 bg-gray-800/60 p-5 rounded-xl shadow-md hover:scale-105 transition-transform">
        <span class="text-blue-500 text-2xl">⚡</span>
        <p class="text-gray-200">Hosting y mantenimiento prioritario</p>
      </div>
      <div class="flex items-start gap-4 bg-gray-800/60 p-5 rounded-xl shadow-md hover:scale-105 transition-transform">
        <span class="text-blue-500 text-2xl">🤝</span>
        <p class="text-gray-200">Soporte técnico preferencial con atención rápida</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-blue-600/20 p-6 sm:p-8 rounded-2xl border border-blue-600 max-w-3xl mx-auto">
      <h3 class="text-xl sm:text-2xl font-semibold mb-3 text-blue-400">El plan definitivo para grandes empresas</h3>
      <p class="text-gray-300 mb-6">
        Perfecto para negocios que requieren expansión internacional, seguridad y un soporte confiable. 
        Con este plan tendrás la tranquilidad de que tu sitio siempre estará optimizado y funcionando al 100%.
      </p>
      <a href="/contacto" 
         class="block sm:inline-block w-full sm:w-auto text-center bg-blue-600 hover:bg-blue-500 px-6 py-3 rounded-lg font-medium transition-colors">
        Quiero mi Plan Premium
      </a>
    </div>
  </section>
</Layout>
