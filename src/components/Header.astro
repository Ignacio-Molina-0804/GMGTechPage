---
// Header.astro
---

<nav class="fixed top-0 left-0 w-full flex items-center justify-between bg-gray-900/90 backdrop-blur-md px-4 sm:px-8 py-3 z-50 shadow-md">
  <!-- Logo -->
  <div class="flex items-center">
    <img
      src="/logos/GMGTechLogoDarkPNG.png"
      alt="GMG Tech Logo"
      class="h-8 sm:h-10 w-auto transition-transform duration-300 hover:scale-110 object-contain"
    />
  </div>

  <!-- Links desktop -->
  <div class="hidden md:flex items-center gap-6 text-white font-medium">
    <a class="hover:text-blue-400 transition" href="/">Inicio</a>
    <div class="relative group">
      <button class="flex items-center gap-1 hover:text-blue-400 transition">
        Servicios
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div
        class="absolute left-0 mt-2 w-44 bg-gray-800/95 rounded-lg shadow-lg
               opacity-0 scale-y-0 group-hover:opacity-100 group-hover:scale-y-100
               origin-top transition-all duration-300"
      >
        <a href="/servicio1" class="block px-4 py-2 hover:bg-gray-700">Básico</a>
        <a href="/servicio2" class="block px-4 py-2 hover:bg-gray-700">Profesional</a>
        <a href="/servicio3" class="block px-4 py-2 hover:bg-gray-700">Premium</a>
      </div>
    </div>
    <a class="hover:text-blue-400 transition" href="/contacto">Contacto</a>
  </div>

  <!-- Botón hamburguesa móvil - CORREGIDO -->
  <button id="menu-btn" class="md:hidden relative w-8 h-8 flex items-center justify-center">
    <div class="relative w-7 h-6 flex flex-col justify-between items-center">
      <span class="bar w-7 h-[3px] bg-white rounded transition-all duration-300 origin-center"></span>
      <span class="bar w-7 h-[3px] bg-white rounded transition-all duration-300 origin-center"></span>
      <span class="bar w-7 h-[3px] bg-white rounded transition-all duration-300 origin-center"></span>
    </div>
  </button>
</nav>

<!-- Menú móvil -->
<div
  id="mobile-menu"
  class="fixed top-14 left-0 w-full bg-gray-900/95 text-white flex flex-col items-center py-6 space-y-5 md:hidden z-40
         transform -translate-y-full opacity-0 transition-all duration-300 ease-in-out"
>
  <a href="/" class="hover:text-blue-400 text-lg">Inicio</a>
  <a href="/servicio1" class="hover:text-blue-400 text-lg">Básico</a>
  <a href="/servicio2" class="hover:text-blue-400 text-lg">Profesional</a>
  <a href="/servicio3" class="hover:text-blue-400 text-lg">Premium</a>
  <a href="/contacto" class="hover:text-blue-400 text-lg">Contacto</a>
</div>

<script src="/src/scripts/headerAnimation.js" defer></script>