---

import LinkedInIcon from "./icons/LinkedInIcon.astro"
import InstagramIcon from "./icons/InstagramIcon.astro"
import WhatsappIcon from "./icons/WhatsappIcon.astro"

---
<footer class="bg-neutral-900 text-neutral-300 py-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center space-y-6">
    
    <!-- Logo -->
    <img src="/logos/GMGTechLogoDarkPNG.png" alt="GMGTECH" class="h-12 sm:h-14" />

    <!-- Redes sociales -->
    <div class="flex space-x-6 text-2xl">
      <a href="https://wa.me/+5492616406896" aria-label="WhatsApp" class="hover:text-green-500 transition">
        <WhatsappIcon/>
      </a>
      <a href="https://www.instagram.com/gmg.tech" aria-label="Instagram" class="hover:text-pink-500 transition">
        <InstagramIcon/>
      </a>
    </div>

    <!-- Copyright -->
    <div class="text-xs sm:text-sm text-neutral-500">
      © {new Date().getFullYear()} GMGTECH. Todos los derechos reservados.
    </div>
  </div>
</footer>
